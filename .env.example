# Public visitor-analytics IDs. Next.js inlines NEXT_PUBLIC_* values at
# build time, including OpenNext builds for the Cloudflare Worker. Set them
# in the build environment before deploy. Wrangler runtime secrets added
# after the build do not reach the client bundle.
#
# Leave a variable unset (or empty) to skip that tracker.
#
# Cloudflare Web Analytics site token (beacon).
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=6ed43d34957a49fcb90ec8e43f7db523
#
# Google Analytics 4 measurement ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LHY01PQCDR
